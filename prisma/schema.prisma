generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Game {
  game_id String @id @default(uuid())
  character_id String
  round Int
  hp Int
  money Int @default(0)

  characters   Character[]
}

model Character {
  game_id   String
  round Int
  data Json

  game Game @relation(fields: [game_id], references: [game_id])

  @@id([game_id, round])
}